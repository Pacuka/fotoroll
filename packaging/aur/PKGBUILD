# Maintainer: Pacuka <69674426+Pacuka@users.noreply.github.com>
pkgname=fotoroll-bin
pkgver=0.11.1
pkgrel=1
pkgdesc="Native Linux desktop client for Immich: browse, back up and manage your photos"
arch=('x86_64')
url="https://github.com/Pacuka/fotoroll"
license=('AGPL-3.0-only')
depends=('alsa-lib' 'e2fsprogs' 'expat' 'fontconfig' 'freetype2' 'fribidi' 'gcc-libs' 'glibc' 'gmp'
         'harfbuzz' 'hicolor-icon-theme' 'libdrm' 'libglvnd' 'libgpg-error' 'libusb' 'libx11' 'libxcb'
         'mesa' 'ttf-font' 'wayland' 'zlib')
optdepends=('libayatana-appindicator: system tray icon'
            'gnome-keyring: keeps the login (or another Secret Service provider such as KWallet or KeePassXC)')
provides=('fotoroll')
conflicts=('fotoroll')
# Flutter's AOT snapshot (libapp.so) breaks when stripped.
options=('!strip' '!debug')
_appimage="Fotoroll-${pkgver}-x86_64.AppImage"
source=("${_appimage}::${url}/releases/download/v${pkgver}/${_appimage}"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/Pacuka/fotoroll/v${pkgver}/LICENSE"
        'fotoroll.sh')
noextract=("${_appimage}")
sha256sums=('7b318281004a325909ab97f5068065bfd5787a800998f8df315942bc6dad6065'
            'a3bad629f67f442b23b5224419e49edafc32e6b9c876b89464f7aafe6091ccde'
            'cb8d4f29123293eeb86cb0e42c39ce45453df54e1bb118ccfc9109b9b05c2de4')

prepare() {
  chmod +x "${_appimage}"
  rm -rf squashfs-root
  "./${_appimage}" --appimage-extract >/dev/null
}

package() {
  install -d "${pkgdir}/opt/fotoroll"
  cp -a squashfs-root/. "${pkgdir}/opt/fotoroll/"
  chmod -R u=rwX,go=rX "${pkgdir}/opt/fotoroll"

  install -Dm755 fotoroll.sh "${pkgdir}/usr/bin/fotoroll"
  install -Dm644 squashfs-root/usr/share/applications/io.github.pacuka.Fotoroll.desktop \
    -t "${pkgdir}/usr/share/applications"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/512x512/apps/io.github.pacuka.Fotoroll.png \
    -t "${pkgdir}/usr/share/icons/hicolor/512x512/apps"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
